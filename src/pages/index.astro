---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>J The Last Boss Repair Clinic — Console & Controller Repair</title>
  <meta name="description" content="Specialist repair shop for PlayStation, Xbox, Nintendo Switch and controllers. Free diagnostics, honest quotes, 90-day warranty." />
  <meta name="theme-color" content="#f4efe6" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="tab-rail" aria-label="Main navigation">
    <a href="#services">01 Services</a>
    <a href="#why">02 Why</a>
    <a href="#process">03 Protocol</a>
    <a href="#reviews">04 Reports</a>
    <a href="#faq">05 FAQ</a>
    <a class="cta" href="#contact">Book repair</a>
  </nav>

  <main id="main">
    <section class="hero">
      <div class="container hero-grid">
        <div class="spread leaf">
          <span class="page-num">pp. 04–05 · §1</span>
          <span class="eyebrow">Free diagnostics // No fix, no fee</span>
          <h1>Broken console?<br>We bring it<br><span style="color:var(--board)">back to life.</span></h1>
          <p class="lead">Specialist repairs for PlayStation, Xbox, Nintendo Switch and controllers — from stick drift to HDMI ports. Honest quotes, careful work, a 90-day warranty.</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:16px;">
            <a class="btn" href="#contact">Book a repair →</a>
            <a class="btn ghost" href="tel:+15550123456">Call the shop</a>
          </div>
          <ul class="trust">
            <li>Free diagnosis</li>
            <li>Same-day options</li>
            <li>90-day warranty</li>
          </ul>
          <p class="hero-signoff">Loot <i>//</i> Repair <i>//</i> Repeat</p>
        </div>

        <aside class="ticket leaf" aria-label="Sample repair ticket">
          <div class="job">Job #1042 // Bay 04</div>
          <div class="device">
            <div>
              <strong>PlayStation 5</strong>
              <span>HDMI port replacement</span>
            </div>
            <span style="margin-left:auto;font-family:var(--font-mono);font-size:10px;background:var(--board);color:var(--paper);padding:2px 6px;">Priority</span>
          </div>
          <div style="font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.1em;display:flex;justify-content:space-between;">
            <span>Repair progress</span><span>75%</span>
          </div>
          <div class="progress"><span></span></div>
          <ol>
            <li class="done"><span></span>Checked in</li>
            <li class="done"><span></span>Diagnosed</li>
            <li class="active"><span></span>Repairing</li>
            <li><span></span>Testing</li>
          </ol>
          <div style="display:flex;justify-content:space-between;margin-top:16px;font-family:var(--font-mono);font-size:11px;">
            <div><span style="opacity:0.6;">Est. pickup</span><br/><strong>Tomorrow · 2:00 pm</strong></div>
            <div style="background:var(--board-3);color:var(--paper);padding:6px 10px;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;">Warranty</div>
          </div>
          <div style="margin-top:16px;font-family:var(--font-mono);font-size:10px;opacity:0.5;">JTLB-1042-05</div>
        </aside>
      </div>
    </section>

    <section class="section" id="services">
      <div class="container">
        <span class="band orange">01 // What we fix</span>
        <h2>Small shop. Serious repairs.</h2>
        <p>Consoles, controllers and handhelds — brought back to full health with the right parts and proper testing.</p>
        <div class="cards-grid">
          <article class="card leaf"><h3>Console repair</h3><p>No power, overheating, random shutdowns. PlayStation, Xbox and Switch, diagnostics to board-level.</p><div class="tags"><span>PS5</span><span>PS4</span><span>Xbox</span><span>Switch</span></div></article>
          <article class="card leaf"><h3>Controller repair</h3><p>Stick drift, dead buttons, not charging or pairing. Most fixed same day while you wait.</p><div class="tags"><span>DualSense</span><span>Joy-Con</span><span>Elite</span></div></article>
          <article class="card leaf"><h3>HDMI port replacement</h3><p>No signal, bent pins or cracked port. In-house micro-soldering and full picture test.</p><div class="tags"><span>PS5</span><span>Xbox Series</span></div></article>
          <article class="card leaf"><h3>Disc drive repair</h3><p>Discs not reading, jamming or grinding. We repair drives, swap lasers, test game discs.</p><div class="tags"><span>PS4</span><span>PS5</span><span>Xbox</span></div></article>
          <article class="card leaf"><h3>Cleaning & thermal</h3><p>Loud fans and hot consoles. Deep clean, fresh thermal paste and pads.</p><div class="tags"><span>All consoles</span><span>Laptops</span></div></article>
          <article class="card leaf"><h3>Retro & handheld</h3><p>Game Boy, DS, 3DS, PSP, Vita. Battery swaps, screens, shells, full restorations.</p><div class="tags"><span>Game Boy</span><span>DS</span><span>PSP</span></div></article>
        </div>
        <p style="margin-top:24px;font-family:var(--font-mono);font-size:12px;">Something else playing up? <a href="#contact" style="color:var(--board);">Send us a message →</a></p>
      </div>
    </section>

    <section class="section" id="why">
      <div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:40px;">
        <div>
          <span class="band yellow">02 // Why J The Last Boss</span>
          <h2>The difference is in the details.</h2>
          <p>No shortcuts, no mystery fees. Careful diagnostics and repairs that hold up long after you take the console home.</p>
          <ul class="feature-list">
            <li><div><strong>Quality parts that last</strong><p>Genuine or premium-grade components — never the cheapest option.</p></div></li>
            <li><div><strong>In-house micro-soldering</strong><p>HDMI and charging ports fixed here, not sent to a third party.</p></div></li>
            <li><div><strong>Prices agreed up front</strong><p>You approve the quote before we start. No surprises on collection.</p></div></li>
            <li><div><strong>Fast, honest turnaround</strong><p>Most jobs in 24–48 hours; we'll tell you if it's not worth fixing.</p></div></li>
          </ul>
        </div>
        <div class="stats">
          <div class="stat leaf"><strong>2,000<span style="font-size:18px;">+</span></strong><p>Devices revived</p></div>
          <div class="stat leaf"><strong>4.9<span style="font-size:18px;">★</span></strong><p>Average review</p></div>
          <div class="stat leaf"><strong>48<span style="font-size:18px;">h</span></strong><p>Typical turnaround</p></div>
          <div class="stat leaf"><strong>90<span style="font-size:18px;">d</span></strong><p>Repair warranty</p></div>
        </div>
      </div>
    </section>

    <section class="section" id="process">
      <div class="container">
        <span class="band green">03 // The protocol</span>
        <h2>From broken to playing in four steps.</h2>
        <ol class="steps">
          <li class="leaf"><span class="step-num">01</span><h3>Tell us what's wrong</h3><p>Send a message or drop in. A quick description is all we need.</p></li>
          <li class="leaf"><span class="step-num">02</span><h3>Free diagnosis</h3><p>We test the device and explain the fault in plain English.</p></li>
          <li class="leaf"><span class="step-num">03</span><h3>You approve the quote</h3><p>Nothing happens until you're happy. Decline and you owe nothing.</p></li>
          <li class="leaf"><span class="step-num">04</span><h3>Repair, test, collect</h3><p>We fix it, test it hard, message you when ready with your 90-day warranty.</p></li>
        </ol>
      </div>
    </section>

    <section class="section" id="reviews">
      <div class="container">
        <span class="band teal">04 // Field reports</span>
        <h2>Trusted by local gamers.</h2>
        <p>Most of our work comes from people telling their friends.</p>
        <div class="review-grid">
          <figure class="review leaf">
            <div style="font-family:var(--font-mono);font-size:10px;color:var(--board);">★★★★★</div>
            <blockquote>"My PS5 was overheating and shutting down mid-game. Fixed in two days and whisper quiet now. Proper job."</blockquote>
            <figcaption><span class="avatar">MT</span><div><strong>Marcus T.</strong><span>PS5 thermal repair</span></div></figcaption>
          </figure>
          <figure class="review leaf">
            <div style="font-family:var(--font-mono);font-size:10px;color:var(--board);">★★★★★</div>
            <blockquote>"Both Joy-Cons had drift. They replaced the sticks while I waited and cleaned them up. Feels brand new."</blockquote>
            <figcaption><span class="avatar">PS</span><div><strong>Priya S.</strong><span>Joy-Con repair</span></div></figcaption>
          </figure>
          <figure class="review leaf">
            <div style="font-family:var(--font-mono);font-size:10px;color:var(--board);">★★★★★</div>
            <blockquote>"Thought my old Game Boy was beyond saving. Restored beautifully, kept me updated the whole time."</blockquote>
            <figcaption><span class="avatar">DR</span><div><strong>Daniel R.</strong><span>Game Boy restoration</span></div></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="container">
        <span class="band blue">05 // Good to know</span>
        <h2>Questions, answered.</h2>
        <div class="faq-list">
          <details><summary>How long does a repair take?<span>+</span></summary><p>Most controller repairs same day; consoles 24–48 hours. If we need to order a part, we give a clear timeframe first.</p></details>
          <details><summary>Do you charge for diagnostics?<span>+</span></summary><p>No. Diagnosis is free, no obligation. If we can't fix it, you pay nothing.</p></details>
          <details><summary>Do you use genuine parts?<span>+</span></summary><p>Genuine where available, premium-grade alternatives otherwise. We tell you exactly what goes in.</p></details>
          <details><summary>What if my console can't be fixed?<span>+</span></summary><p>We tell you honestly before any work. You only pay for approved work.</p></details>
          <details><summary>Do you offer a warranty?<span>+</span></summary><p>Yes — 90 days on parts fitted and work carried out. Keep your receipt.</p></details>
          <details><summary>Can you fix water-damaged consoles?<span>+</span></summary><p>Often yes. Don't switch it on — bring it in ASAP. Sooner is better.</p></details>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container contact-grid">
        <div>
          <span class="band violet">06 // Open a channel</span>
          <h2>Tell us what's playing up.</h2>
          <p>Send a few details and we'll come back with next steps and a rough quote. Or call or drop in.</p>
          <div class="contact-lines">
            <a href="tel:+15550123456"><div><span>Call us</span><strong>+1 (555) 012-3456</strong></div></a>
            <a href="mailto:hello@jtlbrepair.example"><div><span>Email</span><strong>hello@jtlbrepair.example</strong></div></a>
            <a href="https://maps.google.com/?q=Unit+4,+128+High+Street,+Your+Town" target="_blank" rel="noopener"><div><span>Visit the shop</span><strong>Unit 4, 128 High Street, Your Town</strong></div></a>
          </div>
          <div style="margin-top:24px;padding:16px;" class="leaf">
            <div style="font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Opening hours</div>
            <dl style="font-family:var(--font-mono);font-size:12px;">
              <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid var(--line);"><dt>Mon – Fri</dt><dd>9:00 am – 6:00 pm</dd></div>
              <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid var(--line);"><dt>Saturday</dt><dd>10:00 am – 4:00 pm</dd></div>
              <div style="display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid var(--line);"><dt>Sunday</dt><dd>Closed</dd></div>
            </dl>
          </div>
        </div>
        <form class="leaf" id="repairForm" novalidate style="padding:24px;">
          <h3 style="margin-bottom:4px;">Open a repair ticket</h3>
          <span style="font-family:var(--font-mono);font-size:10px;color:var(--board-3);">● Free diagnosis</span>
          <div class="form-row" style="margin-top:16px;">
            <label><span>Your name</span><input type="text" name="name" id="name" placeholder="Alex Smith" required /></label>
            <label><span>Phone or email</span><input type="text" name="contact" id="contactInfo" placeholder="How should we reply?" required /></label>
          </div>
          <label><span>Device</span>
            <div class="select-wrap">
              <select name="device" id="device" required>
                <option value="" selected disabled>Choose your device</option>
                <option>PlayStation 5</option><option>PlayStation 4</option>
                <option>Xbox Series X / S</option><option>Xbox One</option>
                <option>Nintendo Switch</option><option>Controller</option>
                <option>Retro console</option><option>Other</option>
              </select>
            </div>
          </label>
          <label><span>What's the problem?</span><textarea name="message" id="message" rows="4" placeholder="e.g. PS5 turns on for 10 minutes then shuts down." required></textarea></label>
          <button class="btn btn-block" type="submit">Send via WhatsApp →</button>
          <p style="font-family:var(--font-mono);font-size:10px;margin-top:12px;opacity:0.6;">Opens WhatsApp with your details filled in.</p>
          <p class="form-error" id="formError" role="alert" hidden style="color:var(--vermilion);font-family:var(--font-mono);font-size:11px;margin-top:8px;">Please fill in your name, contact details and a short description.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div style="font-family:var(--font-head);font-size:20px;text-transform:uppercase;margin-bottom:8px;">J The Last Boss</div>
          <p style="font-size:15px;opacity:0.7;">The repair bench behind J The Last Boss. Console and controller specialists — honest diagnostics, careful work, 90-day warranty.</p>
          <a href="https://www.youtube.com/@JTheLastBoss" target="_blank" rel="noopener" style="display:inline-block;margin-top:8px;font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;">▶ Watch J The Last Boss</a>
        </div>
        <div class="footer-col"><h4>Repairs</h4><a href="#services">Console repair</a><a href="#services">Controller repair</a><a href="#services">HDMI ports</a><a href="#services">Cleaning & thermal</a><a href="#services">Retro & handheld</a></div>
        <div class="footer-col"><h4>Shop</h4><a href="#why">Why us</a><a href="#process">How it works</a><a href="#reviews">Reviews</a><a href="#faq">FAQ</a><a href="#contact">Book a repair</a></div>
        <div class="footer-col"><h4>Contact</h4><a href="tel:+15550123456">+1 (555) 012-3456</a><a href="mailto:hello@jtlbrepair.example">hello@jtlbrepair.example</a><span style="font-family:var(--font-mono);font-size:11px;opacity:0.6;">Mon–Fri 9–6 · Sat 10–4</span></div>
      </div>
      <div style="margin-top:40px;padding-top:16px;border-top:1px solid rgba(244,239,230,0.15);font-family:var(--font-mono);font-size:10px;opacity:0.5;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <span>© <span id="year">2026</span> J The Last Boss Repair Clinic. All rights reserved.</span>
        <span>Independent repair shop · Not affiliated with Sony, Microsoft or Nintendo.</span>
      </div>
    </div>
  </footer>

  <div class="mobile-cta">
    <a class="btn ghost" href="tel:+15550123456">Call</a>
    <a class="btn" href="#contact">Book a repair</a>
  </div>

  <script>
    const repairForm = document.getElementById('repairForm');
    const formError = document.getElementById('formError');
    const revealItems = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const siblings = Array.from(e.target.parentElement.querySelectorAll('.reveal'));
          const index = siblings.indexOf(e.target);
          e.target.style.transitionDelay = Math.min(index * 70, 280) + 'ms';
          e.target.classList.add('is-visible');
          observer.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
      revealItems.forEach((i) => observer.observe(i));
    } else {
      revealItems.forEach((i) => i.classList.add('is-visible'));
    }
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();
    document.querySelectorAll('.card, .stat, .steps li, .review, .hero-grid > *').forEach((el) => el.classList.add('reveal'));
    if (repairForm) {
      const nameInput = document.getElementById('name');
      const contactInput = document.getElementById('contactInfo');
      const deviceInput = document.getElementById('device');
      const messageInput = document.getElementById('message');
      const fields = [nameInput, contactInput, deviceInput, messageInput];
      fields.forEach((f) => {
        f.addEventListener('input', () => { f.classList.remove('field-error'); formError.hidden = true; });
        f.addEventListener('change', () => { f.classList.remove('field-error'); formError.hidden = true; });
      });
      repairForm.addEventListener('submit', (e) => {
        e.preventDefault();
        formError.hidden = true;
        let valid = true;
        fields.forEach((f) => {
          const v = f.value.trim();
          const empty = v === '' || (f === deviceInput && f.selectedIndex === 0);
          f.classList.toggle('field-error', empty);
          if (empty) valid = false;
        });
        if (!valid) { formError.hidden = false; const fi = fields.find((f) => f.classList.contains('field-error')); if (fi) fi.focus(); return; }
        const lines = [
          "Hi J The Last Boss Repair Clinic, I'd like to book a repair.",
          "",
          "Name: " + nameInput.value.trim(),
          "Contact: " + contactInput.value.trim(),
          "Device: " + deviceInput.value,
          "Problem: " + messageInput.value.trim(),
          "",
          "Sent from the website.",
        ];
        const url = "https://wa.me/15550123456?text=" + encodeURIComponent(lines.join("\n"));
        window.open(url, "_blank", "noopener");
      });
    }
  </script>
</body>
</html>
