---
import '../styles/fonts.css';
import '../styles/global.css';
const services = [
  { title: 'CONSOLE REPAIR', description: 'No power. Random shutdowns. A console that won’t boot. Let’s get to the root of the problem.', tags: ['PS5', 'PS4', 'XBOX', 'SWITCH'], icon: 'console', fault: 'Power / startup' },
  { title: 'CONTROLLER REPAIR', description: 'Stick drift, missed inputs and charging faults. Most controller jobs fixed in 48 hours, so you can get back in control.', tags: ['DUALSENSE', 'JOY-CON', 'XBOX'], icon: 'controller', fault: 'Controller / stick drift' },
  { title: 'HDMI & CHARGING PORTS', description: 'No signal, bent pins or a loose connection. Small components. Big difference.', tags: ['HDMI', 'USB', 'CHARGING'], icon: 'port', fault: 'HDMI / no display' },
  { title: 'CLEANING & THERMAL', description: 'Loud fans and heat getting in the way? Time to deal with what’s building up inside.', tags: ['DEEP CLEAN', 'THERMAL CARE'], icon: 'fan', fault: 'Overheating / fan noise' },
  { title: 'DISC DRIVE REPAIR', description: 'Discs not reading, drives not ejecting or a grinding sound that wasn’t there before.', tags: ['PLAYSTATION', 'XBOX'], icon: 'disc', fault: 'Disc drive' },
  { title: 'RETRO & HANDHELD', description: 'The old favourites still have more to give. Keep your next playthrough on the original hardware.', tags: ['PSP', 'PS VITA', 'DS', 'GAME BOY'], icon: 'handheld', fault: 'Handheld / retro' },
];
const marqueeDevices = ['PlayStation', 'Xbox', 'Nintendo Switch', 'DualSense', 'Joy-Con', 'PSP / PS Vita', 'Game Boy', 'Retro consoles'];
const devices = ['PlayStation', 'Xbox', 'Nintendo Switch', 'Controller', 'Handheld / retro'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>J The Last Boss Repair Clinic — Back to life. Back to the game.</title>
    <meta name="description" content="Console, controller and handheld repairs. Free diagnosis, no fix no fee, and a 90-day repair warranty. Ask JTLB about repairs and upgrades." />
    <meta name="theme-color" content="#0d0b0b" />
    <meta property="og:title" content="JTLB Repair Clinic — Back to life. Back to the game." />
    <meta property="og:description" content="Your console has more games left in it. Explore console, controller and handheld repairs at JTLB." />
    <meta property="og:image" content="/images/jtlb-logo.jpg" />
    <link rel="icon" href="/images/jtlb-icon.jpg" />
    <link rel="preload" href="/fonts/anton.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body id="top">
    <svg class="icon-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" /></symbol>
      <symbol id="console" viewBox="0 0 40 40"><rect x="7" y="5" width="26" height="30" rx="3"/><path d="M7 25h26M14 30h5M26 12v7"/></symbol>
      <symbol id="controller" viewBox="0 0 40 40"><path d="M12 11h16c5 0 8 16 6 19s-6 0-10-4h-8c-4 4-8 7-10 4s1-19 6-19Z"/><path d="M11 19h8m-4-4v8m11-6v1m4 3v1"/></symbol>
      <symbol id="port" viewBox="0 0 40 40"><path d="M5 12h30v14l-6 5H11l-6-5ZM12 18h16m-14 0v6m6-6v6m6-6v6"/></symbol>
      <symbol id="fan" viewBox="0 0 40 40"><rect x="5" y="5" width="30" height="30" rx="4"/><circle cx="20" cy="20" r="3"/><path d="M20 17c-8-12 12-12 3 3m0 0c12-8 12 12-3 3m0 0c8 12-12 12-3-3m0 0c-12 8-12-12 3-3"/></symbol>
      <symbol id="disc" viewBox="0 0 40 40"><circle cx="20" cy="20" r="15"/><circle cx="20" cy="20" r="4"/><path d="M20 10a10 10 0 0 1 10 10M10 20a10 10 0 0 0 10 10"/></symbol>
      <symbol id="handheld" viewBox="0 0 40 40"><rect x="9" y="3" width="22" height="34" rx="4"/><path d="M13 8h14v13H13Zm0 21h8m-4-4v8m9-5v1"/></symbol>
      <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"/></symbol>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="J The Last Boss Repair Clinic home">
          <img src="/images/jtlb-icon.jpg" width="44" height="44" alt="" />
          <span>J The Last Boss<small>REPAIR CLINIC</small></span>
        </a>
        <nav aria-label="Main navigation"><a href="#services">What we fix</a><a href="#clinic">The clinic</a><a href="#process">How it works</a><a href="#faq">FAQ</a></nav>
        <a class="button button-small" href="#repair-form">Start a repair <svg class="icon"><use href="#arrow" /></svg></a>
        <details class="mobile-navigation"><summary>MENU <span aria-hidden="true"></span></summary><nav aria-label="Mobile navigation"><a href="#services">What we fix</a><a href="#clinic">The clinic</a><a href="#process">How it works</a><a href="#faq">FAQ</a><a href="#repair-form">Start a repair</a></nav></details>
      </div>
    </header>
    <main id="main">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <h1>BROKEN CONSOLE?<br />WE BRING IT<br /><span>BACK TO LIFE.</span></h1>
            <p>From stick drift to HDMI faults. Console, controller and handheld repairs with free diagnosis, an upfront quote and a 90-day warranty.</p>
            <div class="hero-actions"><a class="button" href="#repair-form">Start your repair <svg class="icon"><use href="#arrow" /></svg></a><a class="text-link" href="#services">Explore our services <svg class="icon"><use href="#arrow" /></svg></a></div>
            <div class="hero-support"><span><svg class="icon"><use href="#check" /></svg> Free diagnosis</span><span><svg class="icon"><use href="#check" /></svg> No fix, no fee</span><span><svg class="icon"><use href="#check" /></svg> 90-day warranty</span></div>
            <div class="signoff"><span>LOOT</span><b>//</b><span>REPAIR</span><b>//</b><span>REPEAT</span></div>
          </div>
          <div class="ticket-scene">
            <div class="ticket-backing" aria-hidden="true"></div>
            <div class="ticket-seal">REPAIR COVER<strong>90 DAYS</strong><span>PARTS + WORKMANSHIP</span></div>
            <article class="repair-ticket" aria-labelledby="ticket-title">
              <div class="ticket-top"><img src="/images/jtlb-icon.jpg" width="34" height="34" alt=""/><span>JTLB REPAIR CLINIC<small>YOUR COMEBACK STARTS HERE</small></span><svg class="icon"><use href="#port" /></svg></div>
              <div class="ticket-title"><h2 id="ticket-title">LET’S FIX<br />WHAT’S BROKEN.</h2><span class="ticket-stamp">REPAIR<br />ENQUIRY</span></div>
              <div class="ticket-selection"><span>WHAT ARE WE WORKING ON?</span><div class="device-options" role="group" aria-label="Choose a device">{devices.slice(0,4).map((device,i)=><button type="button" data-device={device} aria-pressed={i === 0}>{device === 'Nintendo Switch' ? 'Switch' : device}</button>)}</div></div>
              <div class="ticket-device"><svg class="device-art"><use id="ticket-icon" href="#console" /></svg><div><strong id="ticket-device">PLAYSTATION</strong><p id="device-hint">No power, no picture or running too hot?</p></div></div>
              <a id="device-repair" class="ticket-link" href="#repair-form">Start a PlayStation enquiry <svg class="icon"><use href="#arrow" /></svg></a>
              <div class="ticket-bottom"><span class="barcode" aria-hidden="true"></span><span>DESCRIBE IT. DIAGNOSE IT.<br />GET BACK TO PLAYING.</span></div>
            </article>
            <div class="ticket-turnaround"><svg class="icon"><use href="#check" /></svg><span>FIXED IN 48H<small>Most controller jobs</small></span></div><div class="ticket-caption"><span class="caption-line" aria-hidden="true"></span>ASK. APPROVE. PLAY.</div>
          </div>
        </div>
        <div class="hero-bottom container"><span>BACK TO LIFE. BACK TO THE GAME.</span><a href="#services" aria-label="Scroll to repair services"><svg class="icon"><use href="#arrow" /></svg></a><span>INDEPENDENT CONSOLE REPAIR</span></div>
      </section>
      <div class="device-strip"><div class="container">
        <span class="strip-label">GEAR WE SERVICE</span>
        <div class="marquee" role="region" aria-label="Brands and devices we service">
          <div class="marquee-track">
            {[false, true].map(duplicate => <div class="marquee-group" aria-hidden={duplicate ? 'true' : undefined}>{marqueeDevices.map(device => <span>{device}<i aria-hidden="true">/</i></span>)}</div>)}
          </div>
        </div>
        <button class="marquee-toggle" type="button" aria-pressed="false" aria-label="Pause brand scrolling">Pause</button>
      </div></div>
      <section class="section container" id="services">
        <div class="section-heading"><h2>SMALL SHOP.<br /><span>SERIOUS REPAIRS.</span></h2><div><p>One faulty part shouldn’t end a good run.<br />Find what’s playing up. We’ll take it from there.</p><span class="section-footnote">CONSOLES / CONTROLLERS / HANDHELDS</span></div></div>
        <div class="services-grid">{services.map(service => <a class="service" href="#repair-form" data-fault={service.fault}>
          <div class="service-top"><svg class="service-icon"><use href={`#${service.icon}`} /></svg><svg class="icon service-arrow"><use href="#arrow" /></svg></div><h3>{service.title}</h3><p>{service.description}</p><div class="service-tags">{service.tags.map(tag=><span>{tag}</span>)}</div>
        </a>)}</div>
        <div class="services-note"><span>CAN’T PUT YOUR FINGER ON THE FAULT? DIAGNOSIS IS FREE.</span><a href="#repair-form">Start with the symptoms. <svg class="icon"><use href="#arrow" /></svg></a></div>
        <aside class="upgrade-callout"><div><h3>GOOD GEAR. ROOM TO LEVEL UP.</h3><p>Thinking about an upgrade? Tell us your device and what you want to improve. We’ll discuss compatibility, parts and price before you decide.</p></div><a class="button" href="#repair-form" data-request="Upgrade">Ask about an upgrade <svg class="icon"><use href="#arrow" /></svg></a></aside>
      </section>
      <section class="clinic-section" id="clinic"><div class="container clinic-grid">
        <div class="clinic-visual"><img src="/images/jtlb-logo.webp" alt="The original JTLB Repair Clinic artwork: a zombie technician soldering a circuit board" width="900" height="900" loading="lazy"/><div class="clinic-art-label">THE LAST BOSS<br /><span>YOUR HARDWARE HAS TO FACE.</span></div></div>
        <div class="clinic-copy"><h2>REPAIR THE GEAR.<br /><span>KEEP THE MEMORIES.</span></h2><p class="clinic-lead">The console you saved for. The controller you know by feel. The handheld with one more adventure in it.</p><p>That’s what makes a repair worth asking about. J The Last Boss Repair Clinic is for keeping your gaming hardware in the game — from current consoles to the old favourites.</p><div class="clinic-points"><div><svg class="icon"><use href="#check" /></svg><span>Free diagnosis<strong>Find the fault. Understand your options. No diagnosis fee.</strong></span></div><div><svg class="icon"><use href="#check" /></svg><span>Your quote, agreed upfront<strong>You approve the price before any repair work starts.</strong></span></div><div><svg class="icon"><use href="#check" /></svg><span>No fix, no fee<strong>If we can’t fix it, you don’t pay.</strong></span></div><div><svg class="icon"><use href="#check" /></svg><span>90-day repair warranty<strong>Cover for the parts fitted and the work carried out.</strong></span></div></div><a class="text-link" href="https://www.youtube.com/@JTheLastBoss" target="_blank" rel="noopener noreferrer">Meet J The Last Boss on YouTube <svg class="icon"><use href="#arrow" /></svg></a></div>
      </div></section>
      <section class="section container" id="process">
        <div class="section-heading"><h2>FROM BROKEN<br /><span>TO BACK IN PLAY.</span></h2><p>No technical vocabulary required.<br />Start with what happens when you press power.</p></div>
        <ol class="steps"><li><span class="step-number">01</span><div class="step-line" aria-hidden="true"></div><h3>TELL US THE PROBLEM.</h3><p>Your device, the symptoms and when it started. Mention any drops, liquid damage or previous repairs.</p></li><li><span class="step-number">02</span><div class="step-line" aria-hidden="true"></div><h3>FREE DIAGNOSIS.</h3><p>We check the device and explain the fault. You get a clear diagnosis and repair options without a diagnosis fee.</p></li><li><span class="step-number">03</span><div class="step-line" aria-hidden="true"></div><h3>AGREE THE PLAN.</h3><p>You approve the quote, parts and turnaround before work starts. No surprise bill when you collect.</p></li><li><span class="step-number">04</span><div class="step-line" aria-hidden="true"></div><h3>BACK TO THE GAME.</h3><p>Your repair is tested before collection, with a 90-day warranty on the parts fitted and the work carried out.</p></li></ol>
      </section>
      <section class="section container faq" id="faq"><div><h2>BEFORE YOU<br /><span>PRESS START.</span></h2><p>A few answers before you hand over your hardware.</p></div><div class="faq-list">
        <details><summary>How much will my repair cost?<span aria-hidden="true"></span></summary><p>Diagnosis is free. The repair price depends on the device, fault and parts needed. We explain the repair and quote upfront, and only start once you approve.</p></details>
        <details><summary>How long does a repair take?<span aria-hidden="true"></span></summary><p>Most controller jobs are fixed within 48 hours. Other repairs depend on the fault and parts availability. We’ll discuss the expected turnaround for your specific device before you go ahead.</p></details>
        <details><summary>Do you charge for diagnosis?<span aria-hidden="true"></span></summary><p>No. Diagnosis is free. We check your device, explain the issue and provide a quote before any repair work starts.</p></details>
        <details><summary>What if my device can’t be fixed?<span aria-hidden="true"></span></summary><p>No fix, no fee. If we can’t repair your device, you don’t pay. We’ll explain what we found and talk through the options.</p></details>
        <details><summary>Does my repair come with a warranty?<span aria-hidden="true"></span></summary><p>Yes. Repairs come with a 90-day warranty covering the parts fitted and the work carried out. Keep your repair receipt and contact the shop if a covered issue returns.</p></details>
        <details><summary>Can I ask about an upgrade instead?<span aria-hidden="true"></span></summary><p>Yes. Choose “Upgrade” in the enquiry form, include your exact model and tell us what you want to improve. We’ll discuss compatibility, available parts and the quote before you decide.</p></details>
        <details><summary>What should I bring with my device?<span aria-hidden="true"></span></summary><p>Check which cables or accessories are needed to reproduce the issue. Back up your saves where possible, and remove game discs and memory cards unless requested.</p></details>
        <details><summary>Can I enquire about a different device?<span aria-hidden="true"></span></summary><p>Yes. Choose “Other” in the enquiry form and include the brand, exact model and fault. The shop can confirm whether it can take on the job.</p></details>
        <details><summary>How do I send my repair enquiry?<span aria-hidden="true"></span></summary><p>Use the form below to prepare and copy your message, then paste it into your existing JTLB conversation. </p></details>
      </div></section>
      <section class="contact-section" id="repair"><div class="section container contact-grid">
        <div class="contact-copy"><h2>LET’S GET YOU<br /><span>PLAYING AGAIN.</span></h2><p>Repair or upgrade — let’s talk.<br />Free diagnosis. An upfront quote. No fix, no fee.</p><div class="contact-tip"><svg class="icon"><use href="#check" /></svg><div><strong>A LITTLE DETAIL GOES A LONG WAY.</strong><p>Include your exact model, what happens when you use it, and anything you’ve already tried.</p></div></div><div class="booking-placeholder"><span>BOOKING CONTACT</span><strong>Contact details coming soon</strong><p>Prepare your enquiry below and send it through your existing JTLB conversation.</p></div><div class="contact-brand"><img src="/images/jtlb-icon.jpg" width="48" height="48" alt="" loading="lazy"/><div>J THE LAST BOSS<small>LOOT // REPAIR // REPEAT</small></div></div></div>
        <form id="repair-form" class="enquiry-paper"><div class="form-heading"><span>JTLB / REPAIR ENQUIRY</span><svg class="icon"><use href="#port" /></svg></div><h3>LET’S TALK ABOUT YOUR GEAR.</h3><p class="form-benefit">FREE DIAGNOSIS / QUOTE AGREED UPFRONT</p><fieldset class="request-type"><legend>WHAT DO YOU NEED?</legend><label><input type="radio" name="request" value="Repair" checked /> Repair my gear</label><label><input type="radio" name="request" value="Upgrade" /> Explore an upgrade</label></fieldset><div class="form-row"><div><label for="device">YOUR DEVICE</label><select id="device" name="device" required><option value="">Choose your device</option>{devices.map(device=><option>{device}</option>)}<option>Other</option></select></div><div><label for="model">MODEL <span>(OPTIONAL)</span></label><input id="model" name="model" placeholder="e.g. PS5 Slim" maxlength="100"/></div></div><label for="issue">WHAT WOULD YOU LIKE HELP WITH?</label><textarea id="issue" name="issue" rows="4" required minlength="10" maxlength="2000" placeholder="Describe the fault, or tell us what you’d like to upgrade…"></textarea><button class="button" type="submit">Copy my enquiry <svg class="icon"><use href="#arrow" /></svg></button><p class="form-note">Copy your message and send it through your usual JTLB contact channel. This form doesn’t submit a booking.</p><p id="form-status" role="status" aria-live="polite"></p><textarea id="copy-fallback" aria-label="Your prepared enquiry" hidden readonly></textarea><div class="form-tear"><span class="barcode" aria-hidden="true"></span><span>ONE DEVICE.<br />ANOTHER CHANCE.</span></div></form>
      </div></section>
    </main>
    <footer><div class="container footer-main"><div class="footer-about"><a class="brand" href="#top"><img src="/images/jtlb-icon.jpg" width="44" height="44" alt=""/><span>J The Last Boss<small>REPAIR CLINIC</small></span></a><p>Console, controller and handheld repair.<br />Free diagnosis. No fix, no fee. 90-day warranty.</p></div><div class="footer-links"><span>THE REPAIR BENCH</span><a href="#services">What we fix</a><a href="#process">How it works</a><a href="#repair-form">Start a repair</a></div><div class="footer-links"><span>J THE LAST BOSS</span><a href="#clinic">The clinic</a><a href="https://www.youtube.com/@JTheLastBoss" target="_blank" rel="noopener noreferrer">Watch on YouTube</a><a href="#faq">Questions & answers</a></div></div><div class="container footer-wordmark" aria-hidden="true">LOOT <i>//</i> REPAIR <i>//</i> REPEAT</div><div class="container footer-bottom"><span>© {new Date().getFullYear()} J The Last Boss Repair Clinic</span><span>Independent repair shop. Not affiliated with Sony, Microsoft or Nintendo.</span><a href="#top">BACK TO TOP ↑</a></div></footer>
    <script>
      document.querySelectorAll('.mobile-navigation a').forEach(link => {
        link.addEventListener('click', () => { document.querySelector<HTMLDetailsElement>('.mobile-navigation')!.open = false; });
      });
      const marqueeToggle = document.querySelector<HTMLButtonElement>('.marquee-toggle')!;
      marqueeToggle.addEventListener('click', () => {
        const paused = marqueeToggle.getAttribute('aria-pressed') !== 'true';
        marqueeToggle.setAttribute('aria-pressed', String(paused));
        marqueeToggle.setAttribute('aria-label', paused ? 'Resume brand scrolling' : 'Pause brand scrolling');
        marqueeToggle.textContent = paused ? 'Resume' : 'Pause';
        document.querySelector('.marquee-track')!.classList.toggle('is-paused', paused);
      });
      const form = document.querySelector<HTMLFormElement>('#repair-form')!;
      const deviceSelect = document.querySelector<HTMLSelectElement>('#device')!;
      const issue = document.querySelector<HTMLTextAreaElement>('#issue')!;
      const repairLink = document.querySelector<HTMLAnchorElement>('#device-repair')!;
      let selectedDevice = 'PlayStation';
      const hints: Record<string, string> = {
        PlayStation: 'No power, no picture or running too hot?',
        Xbox: 'Startup trouble, disc issues or no HDMI signal?',
        'Nintendo Switch': 'Charging trouble, screen issues or drifting Joy-Cons?',
        Controller: 'Stick drift, missed inputs or a dead battery?',
      };
      document.querySelectorAll<HTMLButtonElement>('[data-device]').forEach(button => {
        button.addEventListener('click', () => {
          selectedDevice = button.dataset.device!;
          document.querySelectorAll('[data-device]').forEach(option => option.setAttribute('aria-pressed', String(option === button)));
          document.querySelector('#device-hint')!.textContent = hints[selectedDevice];
          document.querySelector('#ticket-device')!.textContent = selectedDevice.toUpperCase();
          document.querySelector('#ticket-icon')!.setAttribute('href', selectedDevice === 'Controller' ? '#controller' : selectedDevice === 'Nintendo Switch' ? '#handheld' : '#console');
          repairLink.firstChild!.textContent = `Start a ${selectedDevice} enquiry `;
        });
      });
      repairLink.addEventListener('click', () => {
        deviceSelect.value = selectedDevice;
        document.querySelector<HTMLInputElement>('input[name="request"][value="Repair"]')!.checked = true;
      });
      document.querySelector('[data-request="Upgrade"]')!.addEventListener('click', () => {
        document.querySelector<HTMLInputElement>('input[name="request"][value="Upgrade"]')!.checked = true;
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-fault]').forEach(link => {
        link.addEventListener('click', () => {
          document.querySelector<HTMLInputElement>('input[name="request"][value="Repair"]')!.checked = true;
          if (!issue.value.trim()) issue.value = `${link.dataset.fault}: `;
          if (link.dataset.fault === 'Controller / stick drift') deviceSelect.value = 'Controller';
          if (link.dataset.fault === 'Handheld / retro') deviceSelect.value = 'Handheld / retro';
        });
      });
      form.addEventListener('input', () => {
        document.querySelector('#form-status')!.textContent = '';
        document.querySelector<HTMLTextAreaElement>('#copy-fallback')!.hidden = true;
      });
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const model = document.querySelector<HTMLInputElement>('#model')!.value.trim();
        const request = new FormData(form).get('request')!.toString();
        const message = `Hi JTLB! I'd like to enquire about ${request === 'Upgrade' ? 'an upgrade' : 'a repair'}.\nDevice: ${deviceSelect.value}${model ? ` (${model})` : ''}\n${request === 'Upgrade' ? 'Upgrade request' : 'Issue'}: ${issue.value.trim()}`;
        const status = document.querySelector<HTMLElement>('#form-status')!;
        const fallback = document.querySelector<HTMLTextAreaElement>('#copy-fallback')!;
        try {
          await navigator.clipboard.writeText(message);
          fallback.hidden = true;
          status.textContent = 'Copied! Paste your enquiry into your conversation with JTLB.';
        } catch {
          fallback.hidden = false;
          fallback.value = message;
          fallback.focus();
          fallback.select();
          status.textContent = 'Your enquiry is ready below. Select and copy it to send to JTLB.';
        }
      });
    </script>
  </body>
</html>
