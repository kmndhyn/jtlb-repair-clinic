---
import '../styles/fonts.css';
import '../styles/global.css';
const services = [
  { title: 'Console repair', description: 'No power, random shutdowns or a console that just won’t boot. Start with the symptoms.', tags: 'PlayStation · Xbox · Nintendo Switch', icon: 'console', fault: 'Power / startup' },
  { title: 'Controller repair', description: 'Stick drift, missed inputs and charging problems shouldn’t decide your next match.', tags: 'DualSense · DualShock · Joy-Con · Xbox', icon: 'controller', fault: 'Controller / stick drift' },
  { title: 'HDMI & charging ports', description: 'No picture? Loose connection? Get damaged ports and charging faults checked.', tags: 'HDMI · USB · Charging connections', icon: 'port', fault: 'HDMI / no display' },
  { title: 'Cleaning & thermal care', description: 'Loud fans, dust buildup and overheating. Give your hardware some breathing room.', tags: 'Deep cleaning · Thermal servicing', icon: 'fan', fault: 'Overheating / fan noise' },
  { title: 'Disc drive repair', description: 'For discs that won’t read, drives that won’t eject and noises that don’t sound right.', tags: 'PlayStation · Xbox', icon: 'disc', fault: 'Disc drive' },
  { title: 'Handheld & retro', description: 'Old favourites deserve another playthrough. Tell us what you’re keeping alive.', tags: 'PSP · PS Vita · Nintendo DS · Game Boy', icon: 'handheld', fault: 'Handheld / retro' },
];
const devices = ['PlayStation', 'Xbox', 'Nintendo Switch', 'Controller', 'Handheld / retro'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JTLB Repair Clinic — Bring your game back to life.</title>
    <meta name="description" content="J The Last Boss Repair Clinic. Console, controller and handheld repairs — from stick drift to HDMI ports. Prepare your repair enquiry." />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" href="/images/jtlb-icon.jpg" />
  </head>
  <body>
    <svg class="icon-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" /></symbol>
      <symbol id="console" viewBox="0 0 40 40"><rect x="7" y="5" width="26" height="30" rx="3"/><path d="M7 25h26M14 30h5M26 12v7"/></symbol>
      <symbol id="controller" viewBox="0 0 40 40"><path d="M12 11h16c5 0 8 16 6 19s-6 0-10-4h-8c-4 4-8 7-10 4s1-19 6-19Z"/><path d="M11 19h8m-4-4v8m11-6v1m4 3v1"/></symbol>
      <symbol id="port" viewBox="0 0 40 40"><path d="M5 12h30v14l-6 5H11l-6-5ZM12 18h16m-14 0v6m6-6v6m6-6v6"/></symbol>
      <symbol id="fan" viewBox="0 0 40 40"><rect x="5" y="5" width="30" height="30" rx="4"/><circle cx="20" cy="20" r="3"/><path d="M20 17c-8-12 12-12 3 3m0 0c12-8 12 12-3 3m0 0c8 12-12 12-3-3m0 0c-12 8-12-12 3-3"/></symbol>
      <symbol id="disc" viewBox="0 0 40 40"><circle cx="20" cy="20" r="15"/><circle cx="20" cy="20" r="4"/><path d="M20 10a10 10 0 0 1 10 10M10 20a10 10 0 0 0 10 10"/></symbol>
      <symbol id="handheld" viewBox="0 0 40 40"><rect x="9" y="3" width="22" height="34" rx="4"/><path d="M13 8h14v13H13Zm0 21h8m-4-4v8m9-5v1"/></symbol>
      <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"/></symbol>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="J The Last Boss Repair Clinic home">
          <img src="/images/jtlb-icon.jpg" width="46" height="46" alt="" />
          <span>J THE LAST BOSS<small>REPAIR CLINIC</small></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#services">Services</a><a href="#process">The process</a><a href="#faq">FAQ</a>
        </nav>
        <a class="button button-small" href="#repair">Start a repair <svg class="icon"><use href="#arrow" /></svg></a>
      </div>
    </header>
    <main id="main">
      <section class="hero container">
        <div class="hero-copy">
          <h1>BROKEN CONSOLE?<br />LET’S BRING IT<br /><span>BACK TO LIFE.</span></h1>
          <p>For the consoles you love. And the games you’re not done with. Console, controller and handheld repairs at JTLB.</p>
          <div class="hero-actions"><a class="button" href="#repair">Start your repair <svg class="icon"><use href="#arrow" /></svg></a><a class="button button-outline" href="#services">See what we fix</a></div>
          <div class="hero-support"><span>Stick drift</span><span>HDMI faults</span><span>Overheating</span></div>
          <p class="signoff">LOOT <b>/</b> REPAIR <b>/</b> REPEAT</p>
        </div>
        <div class="hero-visual">
          <img class="hero-image" src="/images/jtlb-logo.jpg" alt="JTLB’s zombie repair technician mascot working on a circuit board" width="900" height="900" fetchpriority="high" />
          <div class="device-picker">
            <div class="picker-heading"><span>WHAT’S ON YOUR BENCH?</span><span class="tiny-dot" aria-hidden="true"></span></div>
            <div class="device-options" role="group" aria-label="Choose a device">{devices.slice(0,4).map((device,i)=><button type="button" data-device={device} aria-pressed={i === 0}>{device === 'Nintendo Switch' ? 'Switch' : device}</button>)}</div>
            <p id="device-hint">No power, no picture or running too hot?</p>
            <a id="device-repair" href="#repair">Let’s look at your PlayStation <svg class="icon"><use href="#arrow" /></svg></a>
          </div>
        </div>
      </section>
      <div class="device-strip"><div class="container"><span>IN GOOD COMPANY</span><p>PLAYSTATION <i>/</i> XBOX <i>/</i> NINTENDO SWITCH <i>/</i> HANDHELD & RETRO</p></div></div>
      <section class="section container" id="services">
        <div class="section-heading"><h2>SMALL SHOP.<br /><span>SERIOUS REPAIRS.</span></h2><p>One faulty part doesn’t have to mean the end.<br />Here’s where we can help.</p></div>
        <div class="services-grid">{services.map((service)=><a class="service" href="#repair" data-fault={service.fault}>
          <svg class="service-icon"><use href={`#${service.icon}`} /></svg><h3>{service.title}</h3><p>{service.description}</p><div class="service-bottom"><span>{service.tags}</span><svg class="icon"><use href="#arrow" /></svg></div>
        </a>)}</div>
        <div class="services-note"><p>Not sure what’s wrong? Describe what happens when you switch it on.</p><a href="#repair">Start with the symptoms <svg class="icon"><use href="#arrow" /></svg></a></div>
      </section>
      <section class="process-section" id="process"><div class="section container">
        <div class="section-heading"><h2>BACK IN THE GAME.<br /><span>ONE STEP AT A TIME.</span></h2><p>A clear description makes a better starting point.<br />No technical knowledge needed.</p></div>
        <ol class="steps"><li><span class="step-number">01</span><h3>Tell us the problem.</h3><p>Your device, the symptoms and when it started. Include any drops, liquid damage or past repairs.</p></li><li><span class="step-number">02</span><h3>Talk through the repair.</h3><p>Confirm the diagnosis, price, parts and expected turnaround with the shop before proceeding.</p></li><li><span class="step-number">03</span><h3>Get ready to play.</h3><p>Arrange collection and check the testing, aftercare and warranty details for your repair.</p></li></ol>
      </div></section>
      <section class="section container faq" id="faq"><div><h2>GOOD QUESTIONS.<br /><span>STRAIGHT ANSWERS.</span></h2><p>The things to know before handing over your hardware.</p></div><div class="faq-list">
        <details><summary>How much will my repair cost?<span aria-hidden="true"></span></summary><p>It depends on the device, the fault and any parts needed. Include the exact model and symptoms so the shop can advise on the next step and quote.</p></details>
        <details><summary>How long does a repair take?<span aria-hidden="true"></span></summary><p>Diagnosis and parts availability affect turnaround. Ask for an estimate for your specific device before arranging a drop-off.</p></details>
        <details><summary>What should I bring with my device?<span aria-hidden="true"></span></summary><p>Check which cables or accessories are needed to reproduce the issue. Back up your saves where possible, and remove game discs and memory cards unless requested.</p></details>
        <details><summary>Can I enquire about a different device?<span aria-hidden="true"></span></summary><p>Yes. Choose “Other” in the enquiry form and include the brand, exact model and fault. The shop can confirm whether it can take on the job.</p></details>
        <details><summary>How do I send my repair enquiry?<span aria-hidden="true"></span></summary><p>Use the form below to prepare and copy your message, then paste it into your existing JTLB conversation. Verified direct booking details will be added here when available.</p></details>
      </div></section>
      <section class="contact-section" id="repair"><div class="section container contact-grid"><div class="contact-copy"><h2>YOUR NEXT SESSION<br /><span>STARTS HERE.</span></h2><p>Tell us what’s playing up.<br />We’ll help you put the details together.</p><div class="contact-brand"><img src="/images/jtlb-icon.jpg" width="64" height="64" alt="" loading="lazy"/><div>J THE LAST BOSS<small>LOOT / REPAIR / REPEAT</small></div></div><p class="contact-note">Direct booking details are awaiting verification. Copy your enquiry and send it through your usual JTLB contact channel.</p></div>
        <form id="repair-form"><div class="form-heading"><h3>LET’S SEE WHAT’S WRONG.</h3><span>REPAIR ENQUIRY</span></div><label for="device">Your device</label><select id="device" name="device" required><option value="">Choose your device</option>{devices.map(device=><option>{device}</option>)}<option>Other</option></select><label for="issue">What’s the problem?</label><textarea id="issue" name="issue" rows="4" required minlength="10" placeholder="e.g. PS5 powers on but there’s no picture. Tried a different HDMI cable…"></textarea><button class="button" type="submit">Copy repair enquiry <svg class="icon"><use href="#arrow" /></svg></button><p class="form-note">This prepares a message. It doesn’t send a booking.</p><p id="form-status" role="status" aria-live="polite"></p><textarea id="copy-fallback" aria-label="Your prepared enquiry" hidden readonly></textarea></form>
      </div></section>
    </main>
    <footer><div class="container footer-top"><a class="brand" href="#top"><img src="/images/jtlb-icon.jpg" width="46" height="46" alt=""/><span>J THE LAST BOSS<small>REPAIR CLINIC</small></span></a><p>KEEP THE GEAR. KEEP THE MEMORIES.</p><a href="#top">Back to top <svg class="icon"><use href="#arrow" /></svg></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} JTLB Repair Clinic</span><span>Independent repair shop. Not affiliated with Sony, Microsoft or Nintendo.</span></div></footer>
    <script>
      const form = document.querySelector<HTMLFormElement>('#repair-form')!;
      const deviceSelect = document.querySelector<HTMLSelectElement>('#device')!;
      const issue = document.querySelector<HTMLTextAreaElement>('#issue')!;
      const repairLink = document.querySelector<HTMLAnchorElement>('#device-repair')!;
      let selectedDevice = 'PlayStation';
      const hints: Record<string, string> = {
        PlayStation: 'No power, no picture or running too hot?',
        Xbox: 'Startup trouble, disc issues or no HDMI signal?',
        'Nintendo Switch': 'Charging trouble, screen issues or drifting Joy-Cons?',
        Controller: 'Stick drift, missed inputs or a dead battery?',
      };
      document.querySelectorAll<HTMLButtonElement>('[data-device]').forEach(button => {
        button.addEventListener('click', () => {
          selectedDevice = button.dataset.device!;
          document.querySelectorAll('[data-device]').forEach(option => option.setAttribute('aria-pressed', String(option === button)));
          document.querySelector('#device-hint')!.textContent = hints[selectedDevice];
          repairLink.firstChild!.textContent = `Let’s look at your ${selectedDevice} `;
        });
      });
      repairLink.addEventListener('click', () => { deviceSelect.value = selectedDevice; });
      document.querySelectorAll<HTMLAnchorElement>('[data-fault]').forEach(link => {
        link.addEventListener('click', () => {
          if (!issue.value.trim()) issue.value = `${link.dataset.fault}: `;
          if (link.dataset.fault === 'Controller / stick drift') deviceSelect.value = 'Controller';
          if (link.dataset.fault === 'Handheld / retro') deviceSelect.value = 'Handheld / retro';
        });
      });
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const message = `Hi JTLB! I'd like to enquire about a repair.\nDevice: ${deviceSelect.value}\nIssue: ${issue.value}`;
        const status = document.querySelector<HTMLElement>('#form-status')!;
        const fallback = document.querySelector<HTMLTextAreaElement>('#copy-fallback')!;
        try {
          await navigator.clipboard.writeText(message);
          fallback.hidden = true;
          status.textContent = 'Copied! Paste your enquiry into your conversation with JTLB.';
        } catch {
          fallback.hidden = false;
          fallback.value = message;
          fallback.focus();
          fallback.select();
          status.textContent = 'Your enquiry is ready below. Select and copy it to send to JTLB.';
        }
      });
    </script>
  </body>
</html>
