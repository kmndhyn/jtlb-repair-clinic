---
import '../styles/fonts.css';
import '../styles/global.css';

const gear = [
  { name: 'Controllers', value: 'Controller', icon: 'controller', title: 'Get your control back.', models: 'DualSense · DualShock · Xbox · Joy-Con', description: 'The missed shot. The wandering camera. The button that only works sometimes. Let’s sort it.', note: 'Most controller jobs fixed in 48 hours.', issues: [
    ['Stick drift', 'Movement without touching the stick, or an aim that won’t stay put.'],
    ['Buttons & triggers', 'Missed inputs, sticking buttons or an unresponsive trigger.'],
    ['Charging & battery', 'A controller that won’t charge or won’t hold its charge.'],
    ['Connection problems', 'Pairing failures and controllers that keep disconnecting.'],
  ]},
  { name: 'PlayStation', value: 'PlayStation', icon: 'console', title: 'More games ahead.', models: 'PlayStation 5 · PlayStation 4', description: 'A blank screen doesn’t have to mean the end. Start with the symptom; we’ll find the fault.', note: 'Diagnosis is free. Approve your quote before we start.', issues: [
    ['HDMI & no display', 'No signal, a damaged port or a picture that keeps cutting out.'],
    ['Power & startup', 'No power, failed startup or unexpected shutdowns.'],
    ['Cleaning & thermal service', 'Loud fans, overheating or shutdowns during a game.'],
    ['Disc drive repair', 'Discs not reading, ejecting or loading as they should.'],
  ]},
  { name: 'Xbox', value: 'Xbox', icon: 'console', title: 'Keep your next session on.', models: 'Xbox Series X / S · Xbox One', description: 'Power problems, display faults and noisy fans. Tell us what happens when you try to play.', note: 'Diagnosis is free. Approve your quote before we start.', issues: [
    ['HDMI & no display', 'No picture, flickering output or a loose HDMI connection.'],
    ['Power & startup', 'A console that won’t boot, switches off or keeps crashing.'],
    ['Cleaning & thermal service', 'Heat, dust build-up and a fan working harder than it should.'],
    ['Disc drive repair', 'Games not reading or a drive that won’t load or eject a disc.'],
  ]},
  { name: 'Nintendo Switch', value: 'Nintendo Switch', icon: 'switch', title: 'Back to playing anywhere.', models: 'Switch · Switch OLED · Switch Lite', description: 'From the handheld screen to the dock, let’s find what’s getting between you and your games.', note: 'Include your exact model so we can check the right parts.', issues: [
    ['Charging & power', 'Not charging, short battery life or no response to the power button.'],
    ['Screen & display', 'Cracked screens, missing picture or a display fault.'],
    ['Joy-Con & stick drift', 'Drifting sticks, missed button presses or connection problems.'],
    ['Dock & connection faults', 'No picture on the TV, damaged ports or unreliable connections.'],
  ]},
  { name: 'Retro & handheld', value: 'Handheld / retro', icon: 'handheld', title: 'Old favourites. New life.', models: 'Game Boy · DS / 3DS · PSP · PS Vita', description: 'Keep the original hardware in your hands. Tell us the model and what you’d love to bring back.', note: 'Repair options depend on the model and parts availability.', issues: [
    ['Screens & buttons', 'Damaged displays, dead buttons and tired controls.'],
    ['Battery & power', 'Battery replacements, charging issues and devices that won’t start.'],
    ['Ports & connections', 'Loose charging ports or a connection that only works at an angle.'],
    ['Shells & restoration', 'Ask about shell changes and bringing well-loved hardware back to life.'],
  ]},
];
const brands = ['PlayStation', 'Xbox', 'Nintendo Switch', 'DualSense', 'Joy-Con', 'PSP / PS Vita', 'Game Boy', 'Retro consoles'];
const faqs = [
  ['How much will my repair cost?', 'Diagnosis is free. Your quote depends on the device, fault and parts needed. We explain the options and agree the price with you before any repair work starts.'],
  ['How long will I be without my gear?', 'Most controller jobs are fixed within 48 hours. Other repairs depend on the fault and parts availability. We’ll confirm the expected turnaround for your device before you go ahead.'],
  ['What does the 90-day warranty cover?', 'Your repair comes with a 90-day warranty on the parts fitted and the work carried out. Keep your repair receipt and contact the shop if a covered issue returns.'],
  ['What happens if it can’t be fixed?', 'No fix, no fee. If we can’t repair your device, you don’t pay. We’ll explain what we found and talk through your options.'],
  ['Can I upgrade my device instead?', 'Yes, you can enquire about an upgrade. Include your exact model and what you want to improve. We’ll discuss compatibility, available parts and pricing before you decide.'],
  ['What should I bring or send?', 'Check with the shop which cables or accessories are needed to reproduce the fault. Back up your saves where possible, and remove game discs and memory cards unless requested.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JTLB Repair Clinic — This isn’t game over.</title>
    <meta name="description" content="Console, controller and handheld repair at J The Last Boss. Free diagnosis, no fix no fee, 90-day repair warranty. Repairs and upgrade enquiries." />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content="JTLB Repair Clinic — This isn’t game over." />
    <meta property="og:description" content="Get your gear back in the game. Free diagnosis. Upfront quotes. 90-day repair warranty." />
    <meta property="og:image" content="/images/jtlb-logo.jpg" />
    <link rel="icon" href="/images/jtlb-icon.jpg" />
    <link rel="preload" href="/fonts/anton.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body id="top">
    <svg class="icon-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" /></symbol>
      <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4 4 10-10" /></symbol>
      <symbol id="shield" viewBox="0 0 24 24"><path d="m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></symbol>
      <symbol id="search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></symbol>
      <symbol id="console" viewBox="0 0 40 40"><rect x="8" y="4" width="24" height="32" rx="3"/><path d="M8 26h24M14 31h6M25 10v10"/></symbol>
      <symbol id="controller" viewBox="0 0 40 40"><path d="M12 11h16c5 0 8 16 6 19s-6 0-10-4h-8c-4 4-8 7-10 4s1-19 6-19Z"/><path d="M11 19h8m-4-4v8m11-6v1m4 3v1"/></symbol>
      <symbol id="switch" viewBox="0 0 40 40"><rect x="3" y="9" width="34" height="22" rx="5"/><path d="M11 9v22m18-22v22m-13-5V14h8v12Zm-9-9v2m26 3v2"/></symbol>
      <symbol id="handheld" viewBox="0 0 40 40"><rect x="9" y="3" width="22" height="34" rx="4"/><path d="M13 8h14v13H13Zm0 21h8m-4-4v8m9-5v1"/></symbol>
      <symbol id="plus" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"/></symbol>
      <symbol id="play" viewBox="0 0 24 24"><path d="m8 4 12 8-12 8Z"/></symbol>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="J The Last Boss Repair Clinic home"><img src="/images/jtlb-icon.jpg" width="46" height="46" alt=""/><span>J THE LAST BOSS<small>REPAIR CLINIC</small></span></a>
        <nav class="desktop-nav" aria-label="Main navigation"><a href="#services">Repairs</a><a href="#upgrades">Upgrades</a><a href="#clinic">Why JTLB</a><a href="#faq">FAQ</a></nav>
        <a class="button header-cta" href="#repair">Let’s fix your gear <svg class="icon"><use href="#arrow"/></svg></a>
        <details class="mobile-navigation"><summary>Menu <svg class="icon"><use href="#plus"/></svg></summary><nav aria-label="Mobile navigation"><a href="#services">Repairs</a><a href="#upgrades">Upgrades</a><a href="#clinic">Why JTLB</a><a href="#faq">FAQ</a><a href="#repair">Let’s fix your gear</a></nav></details>
      </div>
    </header>
    <main id="main">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <h1>THIS ISN’T<br /><span>GAME OVER.</span></h1>
            <p class="hero-intro">Your gear has another life in it.</p>
            <p class="hero-description">Console, controller and handheld repairs. From stick drift to a dead console, we find the fault and get you back to what you love.</p>
            <div class="hero-actions"><a class="button" href="#services">Find your repair <svg class="icon"><use href="#arrow"/></svg></a><a class="text-link" href="#upgrades">Looking to upgrade? <svg class="icon"><use href="#arrow"/></svg></a></div>
            <p class="hero-assurance"><svg class="icon"><use href="#check"/></svg> Free diagnosis. No fix, no fee. 90-day warranty.</p>
          </div>
          <div class="hardware-stage">
            <div class="hardware-disc" aria-hidden="true"></div>

            <img class="hero-controller" src="/images/dualsense-cutout.webp" width="1536" height="1024" alt="DualSense controller — one of the controllers we repair" fetchpriority="high" />
            <a class="hardware-label label-drift" href="#repair-form" data-enquiry-device="Controller" data-enquiry-issue="Stick drift">Stick drift? <svg class="icon"><use href="#arrow"/></svg></a>
            <div class="turnaround"><span>FIXED IN</span><strong>48<span>H</span></strong><span>MOST CONTROLLER JOBS</span></div>

          </div>
        </div>
        <div class="container assurance-bar"><div><svg class="icon"><use href="#search"/></svg><span><strong>FREE DIAGNOSIS</strong><small>Know the fault before you commit.</small></span></div><div><svg class="icon"><use href="#check"/></svg><span><strong>NO FIX, NO FEE</strong><small>An honest quote. Your call.</small></span></div><div><svg class="icon"><use href="#shield"/></svg><span><strong>90-DAY WARRANTY</strong><small>On the parts fitted and work done.</small></span></div></div>
      </section>

      <div class="device-strip"><div class="container"><span class="strip-label">GEAR WE SERVICE</span><div class="marquee" role="region" aria-label="Brands and devices we service"><div class="marquee-track">{[false,true].map(duplicate => <div class="marquee-group" aria-hidden={duplicate ? 'true' : undefined}>{brands.map(brand => <span>{brand}<i aria-hidden="true">/</i></span>)}</div>)}</div></div><button class="marquee-toggle" type="button" aria-label="Pause brand scrolling" aria-pressed="false"><span class="pause-symbol" aria-hidden="true"></span></button></div></div>

      <section class="section container" id="services">
        <div class="section-heading"><h2>WHAT’S KEEPING YOU<br/><span>OUT OF THE GAME?</span></h2><p>Choose your gear. Find the problem.<br/>We’ll take care of the technical part.</p></div>
        <div class="repair-finder">
          <div class="gear-tabs" role="tablist" aria-label="Choose your device">{gear.map((device,index) => <button type="button" role="tab" id={`tab-${index}`} aria-controls={`panel-${index}`} aria-selected={index===0} tabindex={index===0?0:-1}><svg class="device-icon"><use href={`#${device.icon}`}/></svg><span>{device.name}</span></button>)}</div>
          {gear.map((device,index)=><div class="gear-panel" role="tabpanel" id={`panel-${index}`} aria-labelledby={`tab-${index}`} hidden={index!==0} tabindex="0"><div class="gear-intro"><div class="device-name"><svg class="device-icon"><use href={`#${device.icon}`}/></svg><span>{device.models}</span></div><h3>{device.title}</h3><p>{device.description}</p><div class="device-note"><svg class="icon"><use href="#check"/></svg><span>{device.note}</span></div></div><div class="repair-list">{device.issues.map(([title,description]) => <a href="#repair-form" class="repair-option" data-enquiry-device={device.value} data-enquiry-issue={title}><span><strong>{title}</strong><small>{description}</small></span><svg class="icon"><use href="#arrow"/></svg></a>)}</div></div>)}
        </div>
        <div class="finder-bottom"><p>Not sure what’s wrong? You don’t need to diagnose it yourself.</p><a class="text-link" href="#repair">Tell us what happens <svg class="icon"><use href="#arrow"/></svg></a></div>
        <noscript><p class="no-script-note">For PlayStation, Xbox, Nintendo Switch or retro repairs, choose your device in the enquiry form below.</p></noscript>
      </section>

      <section class="upgrade-section" id="upgrades"><div class="container upgrade-grid"><div><h2>MAKE GOOD GEAR<br/><span>EVEN BETTER.</span></h2><p>A new feel. A fresh shell. A better setup. Tell us what you want to change and we’ll explore what’s possible for your device.</p><a class="button button-dark" href="#repair-form" data-upgrade>Explore an upgrade <svg class="icon"><use href="#arrow"/></svg></a></div><div class="upgrade-detail"><h3>LET’S MAKE A PLAN.</h3><div><span>Bring the idea</span><p>Tell us your exact model and what you’d like to improve.</p></div><div><span>Check the possibilities</span><p>We’ll talk compatibility, available parts and the trade-offs.</p></div><div><span>You decide</span><p>Get a clear quote before anything changes.</p></div></div></div></section>

      <section class="section container clinic" id="clinic"><div class="clinic-story"><div class="clinic-art"><img src="/images/jtlb-logo.webp" alt="Original JTLB Repair Clinic artwork with its zombie repair technician" width="900" height="900" loading="lazy"/></div><div class="clinic-caption"><span>J THE LAST BOSS</span><a href="https://www.youtube.com/@JTheLastBoss" target="_blank" rel="noopener noreferrer" aria-label="Watch J The Last Boss on YouTube"><svg class="icon"><use href="#play"/></svg> Watch the channel</a></div></div><div class="clinic-copy"><h2>GOOD GEAR.<br/>WORTH <span>SAVING.</span></h2><p class="lead">The console you saved for. The controller you know by feel. The handheld you never really outgrew.</p><p>At J The Last Boss Repair Clinic, that’s what we’re here for. Careful repairs, clear answers and another chance for the hardware you love.</p><dl class="promises"><div><dt>We find the fault.</dt><dd>Free diagnosis, with the problem explained in plain English.</dd></div><div><dt>You call the shots.</dt><dd>An upfront quote. No work starts until you approve it.</dd></div><div><dt>We stand by the repair.</dt><dd>Tested before collection, with a 90-day repair warranty.</dd></div></dl></div></section>

      <section class="process-section" id="process"><div class="container"><div class="section-heading"><h2>YOUR COMEBACK.<br/><span>FOUR SIMPLE STEPS.</span></h2><p>From the first message to the next session.<br/>Here’s what happens.</p></div><ol class="steps"><li><span>01</span><h3>Tell us the problem.</h3><p>Your device, what’s wrong and when it started. No technical terms needed.</p></li><li><span>02</span><h3>Get a free diagnosis.</h3><p>We check your gear, find the fault and explain your repair options.</p></li><li><span>03</span><h3>Approve your quote.</h3><p>Agree the price and turnaround before we pick up the tools.</p></li><li><span>04</span><h3>Get back to playing.</h3><p>Repaired, tested and ready for collection. 90-day warranty included.</p></li></ol></div></section>

      <section class="section container faq" id="faq"><div><h2>FAIR QUESTIONS.<br/><span>STRAIGHT ANSWERS.</span></h2><p>Everything you need to know before<br class="desktop-only"/> handing over your gear.</p><a class="text-link" href="#repair">Ask about your device <svg class="icon"><use href="#arrow"/></svg></a></div><div class="faq-list">{faqs.map(([question,answer])=><details><summary>{question}<svg class="icon"><use href="#plus"/></svg></summary><p>{answer}</p></details>)}</div></section>

      <section class="contact-section" id="repair"><div class="container contact-grid"><div class="contact-copy"><h2>LET’S GET YOU<br/><span>PLAYING AGAIN.</span></h2><p>Start with your gear and a few details.<br/>We’ll help you figure out the next move.</p><ul class="contact-benefits"><li><svg class="icon"><use href="#check"/></svg> Free diagnosis</li><li><svg class="icon"><use href="#check"/></svg> No obligation to go ahead</li><li><svg class="icon"><use href="#check"/></svg> Your quote, agreed upfront</li></ul><div class="contact-availability"><strong>Booking contact coming soon.</strong><p>For now, prepare your message here and send it through your existing JTLB conversation.</p></div><div class="contact-signoff"><img src="/images/jtlb-icon.jpg" width="40" height="40" alt="" loading="lazy"/><span>LOOT. REPAIR. REPEAT.</span></div></div>
        <form id="repair-form"><h3>WHAT CAN WE HELP WITH?</h3><fieldset class="request-type"><legend class="sr-only">Choose your request</legend><label><input type="radio" name="request" value="Repair" checked/><span>Repair my gear</span></label><label><input type="radio" name="request" value="Upgrade"/><span>Explore an upgrade</span></label></fieldset><div class="form-row"><div><label for="device">Device</label><select id="device" name="device" required><option value="">Choose your device</option>{gear.map(device=><option value={device.value}>{device.name}</option>)}<option value="Other">Other</option></select></div><div><label for="model">Exact model <span>(optional)</span></label><input id="model" name="model" placeholder="e.g. DualSense, PS5 Slim" maxlength="100"/></div></div><label for="issue" id="issue-label">What’s going wrong?</label><textarea id="issue" name="issue" rows="4" required minlength="10" maxlength="2000" placeholder="What happens when you use it? Tell us the symptoms and anything you’ve tried."></textarea><button class="button" type="submit">Copy my enquiry <svg class="icon"><use href="#arrow"/></svg></button><p class="form-note">This prepares a message for you to copy. It doesn’t send a booking or reserve a repair slot.</p><p id="form-status" role="status" aria-live="polite"></p><textarea id="copy-fallback" aria-label="Your prepared enquiry" readonly hidden></textarea></form>
      </div></section>
    </main>
    <footer><div class="container footer-top"><a class="brand" href="#top"><img src="/images/jtlb-icon.jpg" width="46" height="46" alt=""/><span>J THE LAST BOSS<small>REPAIR CLINIC</small></span></a><nav aria-label="Footer navigation"><a href="#services">Repairs</a><a href="#upgrades">Upgrades</a><a href="#process">How it works</a><a href="#faq">FAQ</a></nav><a class="back-top" href="#top">Back to top <svg class="icon"><use href="#arrow"/></svg></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} J The Last Boss Repair Clinic.</span><span>Independent repair. Not affiliated with Sony, Microsoft or Nintendo.</span><details class="image-credits"><summary>Image credits</summary><p>JTLB artwork from the supplied <a href="https://github.com/simonbiala-art/circuitfix-website">reference repository</a>. DualSense image (background removed): <a href="https://www.playstation.com/en-us/accessories/dualsense-wireless-controller/">Sony Interactive Entertainment</a>.</p></details></div></footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
